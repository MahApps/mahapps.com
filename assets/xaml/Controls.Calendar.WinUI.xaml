<!--
    A WinUI (Fluent 2) flavoured Calendar for MahApps.Metro.

    Drop-in dictionary: it defines only keyed resources and merges the styles it
    builds on, so it can be added to an application on its own -

        <ResourceDictionary Source="Controls.Calendar.WinUI.xaml" />
        ...
        <Calendar Style="{StaticResource MahApps.Styles.Calendar.WinUI}" />

    - or moved into MahApps.Metro's Styles folder as-is and merged from
    Controls.xaml next to Controls.Calendar.xaml.

    This is the Fluent 2 look that arrived with WinUI 2.6 and Windows 11 -
    rounded throughout. It is deliberately not called Win10: the Windows 10 era
    of Fluent was square, which is what the library's existing CheckBox.Win10
    and RadioButton.Win10 styles follow.

    What differs from MahApps.Styles.Calendar:

      * no accent-filled header bar; the month button and the two chevrons sit
        on the calendar's own background, as WinUI's CalendarView does
      * round day cells of a fixed 40x40, so the grid is even and the selection
        reads as a disc rather than a rectangle
      * today is an accent-filled disc, a selected day an accent ring, and a day
        that is both keeps the fill and gains a contrasting ring
      * hover and pressed are neutral greys rather than tinted accent, so the
        accent only ever means "today" or "selected"
      * day-of-week titles are muted rather than bold, with a hairline under the
        row separating them from the grid
      * the month and year cells are rounded rectangles following the same rules

    Every colour comes from the theme's brushes, so it follows the accent and
    works in the light and dark themes without further work.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.Calendar.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <system:Double x:Key="MahApps.Sizes.CalendarDayButton.WinUI">40</system:Double>
    <CornerRadius x:Key="MahApps.CornerRadius.CalendarDayButton.WinUI">20</CornerRadius>
    <CornerRadius x:Key="MahApps.CornerRadius.CalendarButton.WinUI">4</CornerRadius>
    <CornerRadius x:Key="MahApps.CornerRadius.Calendar.WinUI">8</CornerRadius>

    <!--  A day cell: a round disc that is filled for today and ringed when selected.  -->
    <Style x:Key="MahApps.Styles.CalendarDayButton.WinUI" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{DynamicResource MahApps.CornerRadius.CalendarDayButton.WinUI}" />
        <Setter Property="ClickMode" Value="Release" />
        <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}, Path=FontFamily, Mode=OneWay}" />
        <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}, Path=FontSize, Mode=OneWay}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="Height" Value="{DynamicResource MahApps.Sizes.CalendarDayButton.WinUI}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Width" Value="{DynamicResource MahApps.Sizes.CalendarDayButton.WinUI}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Grid>
                        <!--  Fill: hover and pressed, and the accent disc for today.  -->
                        <Border x:Name="Fill"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}" />

                        <!--  Ring: the selected day.  -->
                        <Border x:Name="Ring"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}" />

                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <!--  A blacked-out day keeps its number and gets a line through it.  -->
                        <Rectangle x:Name="Blackout"
                                   Width="18"
                                   Height="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource MahApps.Brushes.Gray3}"
                                   Visibility="Collapsed" />

                        <Border x:Name="FocusVisual"
                                BorderBrush="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  Days of the previous or next month.  -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray8}" />
                        </Trigger>

                        <!--  Selected: an accent ring, the number in the accent colour.  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                        </Trigger>

                        <!--  Today: a filled accent disc.  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}, Path=IsTodayHighlighted}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsToday}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                        </MultiDataTrigger>

                        <!--  Today and selected: keep the fill, ring it in the theme foreground
                              so the ring stays visible against the accent.  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}, Path=IsTodayHighlighted}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsToday}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                        </MultiDataTrigger>

                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="Blackout" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusVisual" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                            <Setter TargetName="Fill" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  A month or year cell: the same rules on a rounded rectangle.  -->
    <Style x:Key="MahApps.Styles.CalendarButton.WinUI" TargetType="{x:Type CalendarButton}">
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{DynamicResource MahApps.CornerRadius.CalendarButton.WinUI}" />
        <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}, Path=FontFamily, Mode=OneWay}" />
        <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}, Path=FontSize, Mode=OneWay}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Grid Margin="2">
                        <Border x:Name="Fill"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}" />
                        <Border x:Name="Ring"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}" />
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray8}" />
                        </Trigger>
                        <!--  A month or year cell has no IsSelected; the property that
                              says it holds the selection is HasSelectedDays.  -->
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Header chevrons and the month button, all flat on the calendar background.  -->
    <ControlTemplate x:Key="MahApps.Templates.Button.Calendar.WinUI" TargetType="{x:Type Button}">
        <Grid Background="Transparent">
            <Border x:Name="Fill"
                    Background="Transparent"
                    CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}" />
            <ContentPresenter x:Name="Content"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray8}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Content" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MahApps.Styles.Button.Calendar.Header.WinUI" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10 0" />
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.Button.Calendar.WinUI}" />
    </Style>

    <Style x:Key="MahApps.Styles.Button.Calendar.Previous.WinUI" TargetType="{x:Type Button}">
        <Setter Property="Content" Value="&#xE70E;" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.Button.Calendar.WinUI}" />
        <Setter Property="Width" Value="32" />
    </Style>

    <Style x:Key="MahApps.Styles.Button.Calendar.Next.WinUI" TargetType="{x:Type Button}">
        <Setter Property="Content" Value="&#xE70D;" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.Button.Calendar.WinUI}" />
        <Setter Property="Width" Value="32" />
    </Style>

    <Style x:Key="MahApps.Styles.CalendarItem.WinUI" TargetType="{x:Type CalendarItem}">
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{DynamicResource MahApps.CornerRadius.Calendar.WinUI}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <ControlTemplate.Resources>
                        <!--  Day-of-week titles: muted, not bold.  -->
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Margin="0 4 0 8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                       Text="{Binding}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>

                    <Grid x:Name="PART_Root">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Header: month button on the left, chevrons on the right.  -->
                                <Grid Grid.Row="0" Margin="4 4 4 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_HeaderButton"
                                            Grid.Column="0"
                                            mah:ControlsHelper.CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.CornerRadius)}"
                                            Focusable="False"
                                            Style="{DynamicResource MahApps.Styles.Button.Calendar.Header.WinUI}" />
                                    <Button x:Name="PART_PreviousButton"
                                            Grid.Column="1"
                                            mah:ControlsHelper.CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.CornerRadius)}"
                                            Focusable="False"
                                            Style="{DynamicResource MahApps.Styles.Button.Calendar.Previous.WinUI}" />
                                    <Button x:Name="PART_NextButton"
                                            Grid.Column="2"
                                            mah:ControlsHelper.CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.CornerRadius)}"
                                            Focusable="False"
                                            Style="{DynamicResource MahApps.Styles.Button.Calendar.Next.WinUI}" />
                                </Grid>

                                <!--  Hairline under the day-of-week row. The row itself is drawn
                                      by the month view, so the line sits above it and is hidden
                                      whenever the year or decade view is showing.  -->
                                <Border x:Name="HeaderSeparator"
                                        Grid.Row="1"
                                        Height="1"
                                        Margin="6 8 6 0"
                                        Background="{DynamicResource MahApps.Brushes.Gray9}" />

                                <Grid x:Name="PART_MonthView"
                                      Grid.Row="2"
                                      Margin="6 0 6 6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                </Grid>

                                <Grid x:Name="PART_YearView"
                                      Grid.Row="2"
                                      Margin="6 6 6 6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Hidden">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="PART_DisabledVisual"
                                Background="{DynamicResource MahApps.Brushes.Control.Disabled}"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                Opacity="0"
                                Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_DisabledVisual" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="HeaderSeparator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="HeaderSeparator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MahApps.Styles.Calendar.WinUI" TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CalendarButtonStyle" Value="{DynamicResource MahApps.Styles.CalendarButton.WinUI}" />
        <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource MahApps.Styles.CalendarDayButton.WinUI}" />
        <Setter Property="CalendarItemStyle" Value="{DynamicResource MahApps.Styles.CalendarItem.WinUI}" />
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Content}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <Grid x:Name="PART_Root"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          Background="Transparent">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      Style="{TemplateBinding CalendarItemStyle}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

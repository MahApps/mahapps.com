<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Replaces the [Nuget] Source pin from the old cake.config: the site
       generator only ever needs nuget.org, so clear whatever the machine or
       user level config contributes. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

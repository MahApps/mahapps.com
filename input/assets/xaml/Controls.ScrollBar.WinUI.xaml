<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        A Fluent 2 / WinUI scrollbar for MahApps.Metro, following the two
        visualisations described in "Scroll viewer controls":
        https://learn.microsoft.com/windows/apps/develop/ui/controls/scroll-controls

          - the panning indicator: a 2 unit line at the edge of the content,
            all there is until the pointer arrives;
          - the scrollbar proper: a 6 unit thumb with a chevron button at each
            end, on a rounded panel, which the indicator morphs into when the
            pointer moves over it.

        The outer edge is the anchor. The indicator sits flush against it, and
        everything that grows on hover - the panel and the thumb - grows
        inwards: leftwards for a vertical bar, upwards for a horizontal one.

        The bar is 16 units wide and is meant to be laid *over* the content
        rather than beside it, which is what MahApps.Styles.ScrollViewer.WinUI
        in this file does. Without that a 16 unit column stands empty around a
        2 unit line whenever the pointer is elsewhere.

        Drop-in: merge this dictionary after Controls.xaml, then give ScrollBar
        and ScrollViewer implicit styles based on the two below.
    -->

    <system:Double x:Key="MahApps.Sizes.ScrollBar.WinUI">16</system:Double>
    <system:Double x:Key="MahApps.Sizes.ScrollBar.WinUI.Indicator">2</system:Double>
    <system:Double x:Key="MahApps.Sizes.ScrollBar.WinUI.Thumb">6</system:Double>
    <system:Double x:Key="MahApps.Sizes.ScrollBar.WinUI.Thumb.MinLength">24</system:Double>

    <CornerRadius x:Key="MahApps.CornerRadius.ScrollBar.WinUI">8</CornerRadius>
    <CornerRadius x:Key="MahApps.CornerRadius.ScrollBar.WinUI.Thumb">3</CornerRadius>

    <Duration x:Key="MahApps.Duration.ScrollBar.WinUI">0:0:0.12</Duration>

    <Geometry x:Key="MahApps.Geometry.ScrollBar.WinUI.Up">M 0,3 L 3,0 L 6,3</Geometry>
    <Geometry x:Key="MahApps.Geometry.ScrollBar.WinUI.Down">M 0,0 L 3,3 L 6,0</Geometry>
    <Geometry x:Key="MahApps.Geometry.ScrollBar.WinUI.Left">M 3,0 L 0,3 L 3,6</Geometry>
    <Geometry x:Key="MahApps.Geometry.ScrollBar.WinUI.Right">M 0,0 L 3,3 L 0,6</Geometry>

    <!--  The chevrons, which exist only while the bar is expanded.  -->
    <Style x:Key="MahApps.Styles.RepeatButton.ScrollBar.WinUI.Line" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}" />
        <Setter Property="Interval" Value="50" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}">
                        <Path x:Name="Glyph"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{TemplateBinding Content}"
                              SnapsToDevicePixels="True"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource MahApps.Brushes.Gray1}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The page area either side of the thumb: a hit target, nothing more.  -->
    <Style x:Key="MahApps.Styles.RepeatButton.ScrollBar.WinUI.Page" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MahApps.Styles.Thumb.ScrollBar.WinUI" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray3}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Visual"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource MahApps.CornerRadius.ScrollBar.WinUI.Thumb}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Visual" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray2}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Visual" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray1}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Visual" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Two thumb styles rather than one: the indicator grows on Width for a
        vertical bar and on Height for a horizontal one, and an animation has
        to name the property it drives.
    -->
    <Style x:Key="MahApps.Styles.Thumb.ScrollBar.WinUI.Vertical"
           BasedOn="{StaticResource MahApps.Styles.Thumb.ScrollBar.WinUI}"
           TargetType="{x:Type Thumb}">
        <!--
            Flush against the edge of the content. The template animates the
            margin out to 5 as the bar expands, which is what leaves the 6 unit
            thumb in the middle of the 16 unit panel.
        -->
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource MahApps.Sizes.ScrollBar.WinUI.Thumb.MinLength}" />
        <Setter Property="Width" Value="{DynamicResource MahApps.Sizes.ScrollBar.WinUI.Indicator}" />
    </Style>

    <Style x:Key="MahApps.Styles.Thumb.ScrollBar.WinUI.Horizontal"
           BasedOn="{StaticResource MahApps.Styles.Thumb.ScrollBar.WinUI}"
           TargetType="{x:Type Thumb}">
        <Setter Property="Height" Value="{DynamicResource MahApps.Sizes.ScrollBar.WinUI.Indicator}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="{DynamicResource MahApps.Sizes.ScrollBar.WinUI.Thumb.MinLength}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <ControlTemplate x:Key="MahApps.Templates.ScrollBar.WinUI.Vertical" TargetType="{x:Type ScrollBar}">
        <Grid x:Name="Root" Background="{TemplateBinding Background}">
            <Border x:Name="Panel"
                    Width="{DynamicResource MahApps.Sizes.ScrollBar.WinUI.Thumb}"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource MahApps.Brushes.Gray10}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource MahApps.CornerRadius.ScrollBar.WinUI}"
                    Opacity="0" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <RepeatButton x:Name="LineUp"
                              Grid.Row="0"
                              Height="{DynamicResource MahApps.Sizes.ScrollBar.WinUI}"
                              Command="ScrollBar.LineUpCommand"
                              Content="{StaticResource MahApps.Geometry.ScrollBar.WinUI.Up}"
                              Opacity="0"
                              Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.WinUI.Line}"
                              Visibility="Collapsed" />
                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                    <Track.Resources>
                        <system:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">24</system:Double>
                    </Track.Resources>
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.WinUI.Page}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <mah:MetroThumb x:Name="Thumb" Style="{DynamicResource MahApps.Styles.Thumb.ScrollBar.WinUI.Vertical}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.WinUI.Page}" />
                    </Track.IncreaseRepeatButton>
                </Track>
                <RepeatButton x:Name="LineDown"
                              Grid.Row="2"
                              Height="{DynamicResource MahApps.Sizes.ScrollBar.WinUI}"
                              Command="ScrollBar.LineDownCommand"
                              Content="{StaticResource MahApps.Geometry.ScrollBar.WinUI.Down}"
                              Opacity="0"
                              Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.WinUI.Line}"
                              Visibility="Collapsed" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!--
                    The chevrons take their rows the moment they become visible,
                    so the track shortens and the thumb shifts a little. That is
                    what the two visualisations do in WinUI as well: the panning
                    indicator runs the full height, the expanded bar does not.
                -->
                <Setter TargetName="LineUp" Property="Visibility" Value="Visible" />
                <Setter TargetName="LineDown" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Panel"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="LineUp"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="LineDown"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="Panel"
                                             Storyboard.TargetProperty="Width"
                                             To="16"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                             Storyboard.TargetProperty="Width"
                                             To="6"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="Margin"
                                                To="0 0 5 0"
                                                Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Panel"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="LineUp"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="LineDown"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="Panel"
                                             Storyboard.TargetProperty="Width"
                                             To="6"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                             Storyboard.TargetProperty="Width"
                                             To="2"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="Margin"
                                                To="0"
                                                Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MahApps.Templates.ScrollBar.WinUI.Horizontal" TargetType="{x:Type ScrollBar}">
        <Grid x:Name="Root" Background="{TemplateBinding Background}">
            <Border x:Name="Panel"
                    Height="{DynamicResource MahApps.Sizes.ScrollBar.WinUI.Thumb}"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource MahApps.Brushes.Gray10}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource MahApps.CornerRadius.ScrollBar.WinUI}"
                    Opacity="0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <RepeatButton x:Name="LineLeft"
                              Grid.Column="0"
                              Width="{DynamicResource MahApps.Sizes.ScrollBar.WinUI}"
                              Command="ScrollBar.LineLeftCommand"
                              Content="{StaticResource MahApps.Geometry.ScrollBar.WinUI.Left}"
                              Opacity="0"
                              Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.WinUI.Line}"
                              Visibility="Collapsed" />
                <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                    <Track.Resources>
                        <system:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">24</system:Double>
                    </Track.Resources>
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.WinUI.Page}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <mah:MetroThumb x:Name="Thumb" Style="{DynamicResource MahApps.Styles.Thumb.ScrollBar.WinUI.Horizontal}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.WinUI.Page}" />
                    </Track.IncreaseRepeatButton>
                </Track>
                <RepeatButton x:Name="LineRight"
                              Grid.Column="2"
                              Width="{DynamicResource MahApps.Sizes.ScrollBar.WinUI}"
                              Command="ScrollBar.LineRightCommand"
                              Content="{StaticResource MahApps.Geometry.ScrollBar.WinUI.Right}"
                              Opacity="0"
                              Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.WinUI.Line}"
                              Visibility="Collapsed" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="LineLeft" Property="Visibility" Value="Visible" />
                <Setter TargetName="LineRight" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Panel"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="LineLeft"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="LineRight"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="Panel"
                                             Storyboard.TargetProperty="Height"
                                             To="16"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                             Storyboard.TargetProperty="Height"
                                             To="6"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="Margin"
                                                To="0 0 0 5"
                                                Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Panel"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="LineLeft"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="LineRight"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="Panel"
                                             Storyboard.TargetProperty="Height"
                                             To="6"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                             Storyboard.TargetProperty="Height"
                                             To="2"
                                             Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="Margin"
                                                To="0"
                                                Duration="{StaticResource MahApps.Duration.ScrollBar.WinUI}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MahApps.Styles.ScrollBar.WinUI" TargetType="{x:Type ScrollBar}">
        <!--  Transparent, not unset: all 16 units have to answer hit tests or the pointer never reaches the bar.  -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="{DynamicResource MahApps.Sizes.ScrollBar.WinUI}" />
                <Setter Property="Template" Value="{DynamicResource MahApps.Templates.ScrollBar.WinUI.Horizontal}" />
                <Setter Property="Width" Value="Auto" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template" Value="{DynamicResource MahApps.Templates.ScrollBar.WinUI.Vertical}" />
                <Setter Property="Width" Value="{DynamicResource MahApps.Sizes.ScrollBar.WinUI}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The scrollbars sit on top of the content instead of beside it, as the
        WinUI guidance describes ("overlaid as 16px on top of the content").
        Leave 16 units of padding at the edge of anything interactive, or the
        expanded bar will cover it.
    -->
    <Style x:Key="MahApps.Styles.ScrollViewer.WinUI" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False"
                                                CanVerticallyScroll="False"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   Minimum="0"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   VerticalAlignment="Bottom"
                                   Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   Minimum="0"
                                   Orientation="Horizontal"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="mah:ScrollViewerHelper.VerticalScrollBarOnLeftSide" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="mah:ScrollViewerHelper.VerticalScrollBarOnLeftSide" Value="False" />
    </Style>

</ResourceDictionary>

Title: Home
NoTitle: true
NoSidebar: true
NoContainer: true
---
<div class="jumbotron">
    <div class="container">
        <h1>What is MahApps.Metro?</h1>
        <p>MahApps.Metro is a framework that allows developers to cobble together a Metro or Modern UI for their own WPF applications with minimal effort.</p>
        <p>
            <a class="btn btn-primary btn-lg mr-2" href="@Context.GetLink("/docs/guides/quick-start")" role="button">Get Started &raquo;</a>
            <a class="btn btn-primary btn-lg" href="@Context.GetLink("/about")" role="button">About MahApps.Metro</a>
        </p>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-12 col-sm-6">
            <h3 class="align-top">Enhance the default controls</h3>
            <p>
                MahApps.Metro overrides the default style of all common WPF controls and gives them a modern look.
            </p>

            <h3>More than just styles</h3>
            <p>
                MahApps.Metro also includes some custom controls based on concepts from Windows Phone, Windows 8 and Window 10 (UWP) Apps.
            </p>

            <h3>Open source</h3>
            <p>
                We believe in open source and so should you. Something not right? Something could be improved? Or something to add?
                The source code for MahApps.Metro is <a href="https://github.com/MahApps/MahApps.Metro">hosted on GitHub</a> and
                includes everything needed to build it yourself, so drop in and help us make it better.
            </p>
            <p><img style="width: 40%;float: left;margin: 5px 5px 5px 5px" src="@Context.GetLink("/assets/img/oss.png")" alt=""/></p>
        </div>
        <div class="col-12 col-sm-6">
            <img style="width: 100%;" src="@Context.GetLink("/assets/img/screenshot.png")" alt=""/>
        </div>
    </div>
</div>

<section class="app-samples">
    <div class="container">
        <h2 class="app-samples-title">Built with MahApps.Metro</h2>
        <p class="app-samples-lead">A few of the applications people have shipped with it.</p>

        <div class="flipview" id="app-samples" role="group" aria-roledescription="carousel" aria-label="Applications built with MahApps.Metro">
            <button class="flipview-nav flipview-prev" type="button" aria-controls="app-samples-viewport" aria-label="Previous application">
                <span aria-hidden="true">&#8249;</span>
            </button>

            <div class="flipview-viewport" id="app-samples-viewport" aria-live="polite">
                <figure class="flipview-item is-active">
                    <a href="https://www.masterpackager.com/master-packager">
                        <img src="@Context.GetLink("/assets/img/samples/master_packager.png")" alt="Master Packager"/>
                    </a>
                    <figcaption>
                        <strong>Master Packager</strong>
                        Software to view, create and edit Microsoft Windows Installer (MSI) and MST files for free
                    </figcaption>
                </figure>

                <figure class="flipview-item">
                    <a href="https://markdownmonster.west-wind.com">
                        <img src="@Context.GetLink("/assets/img/samples/markdown_monster.png")" alt="Markdown Monster"/>
                    </a>
                    <figcaption>
                        <strong>Markdown Monster</strong>
                        An extensible Markdown editor, viewer and weblog publisher for Windows
                        by <a href="https://github.com/RickStrahl">&#64;RickStrahl</a>
                    </figcaption>
                </figure>

                <figure class="flipview-item">
                    <a href="https://github.com/chocolatey/ChocolateyGUI">
                        <img src="@Context.GetLink("/assets/img/samples/chocolatey_gui.png")" alt="Chocolatey GUI"/>
                    </a>
                    <figcaption>
                        <strong>Chocolatey GUI</strong>
                        A user interface for <a href="https://chocolatey.org/">Chocolatey</a>, a machine package manager for Windows
                    </figcaption>
                </figure>

                <figure class="flipview-item">
                    <a href="https://github.com/BornToBeRoot/NETworkManager">
                        <img src="@Context.GetLink("/assets/img/samples/networkmanager.png")" alt="NETworkManager"/>
                    </a>
                    <figcaption>
                        <strong>NETworkManager</strong>
                        A powerful tool for managing networks and troubleshooting network problems
                        by <a href="https://github.com/BornToBeRoot">&#64;BornToBeRoot</a>
                    </figcaption>
                </figure>
            </div>

            <button class="flipview-nav flipview-next" type="button" aria-controls="app-samples-viewport" aria-label="Next application">
                <span aria-hidden="true">&#8250;</span>
            </button>
        </div>

        <div class="flipview-dots" role="tablist" aria-label="Choose an application"></div>
    </div>
</section>

<script>
    (function () {
        var flipview = document.getElementById('app-samples');
        if (!flipview) { return; }

        var items = [].slice.call(flipview.querySelectorAll('.flipview-item'));
        var dotBar = document.querySelector('.flipview-dots');
        var index = 0;

        var dots = items.map(function (item, i) {
            var dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'flipview-dot';
            dot.setAttribute('role', 'tab');
            var label = item.querySelector('figcaption strong');
            dot.setAttribute('aria-label', label ? label.textContent : 'Application ' + (i + 1));
            dot.addEventListener('click', function () { show(i, i > index); start(); });
            dotBar.appendChild(dot);
            return dot;
        });

        var DIRECTIONS = ['from-right', 'from-left', 'to-left', 'to-right'];

        // A little longer than the 0.35s the stylesheet animates for.
        var CLEAR_AFTER = 400;
        var leavingTimer = null;

        function show(next, forwards) {
            var previous = index;
            index = (next + items.length) % items.length;
            if (index === previous) { return; }

            items.forEach(function (item, i) {
                item.classList.remove('is-leaving');
                DIRECTIONS.forEach(function (c) { item.classList.remove(c); });
                item.classList.toggle('is-active', i === index);
                // Keep the hidden slides out of the tab order.
                item.querySelectorAll('a').forEach(function (link) {
                    link.tabIndex = i === index ? 0 : -1;
                });
            });

            // The incoming slide comes from the side you are heading towards,
            // the outgoing one leaves the opposite way.
            if (previous !== null) {
                items[index].classList.add(forwards ? 'from-right' : 'from-left');

                var leaving = items[previous];
                leaving.classList.add('is-leaving', forwards ? 'to-left' : 'to-right');

                // The outgoing slide has to lose is-leaving again, or it stays
                // visible in the shared grid cell on top of the new one. This
                // used to hang off animationend, which never fires when there
                // is no animation to end - as under prefers-reduced-motion,
                // where the stylesheet turns the animation off. A timer does
                // not care whether anything animated.
                clearTimeout(leavingTimer);
                leavingTimer = setTimeout(function () {
                    leaving.classList.remove('is-leaving');
                    DIRECTIONS.forEach(function (c) { leaving.classList.remove(c); });
                }, CLEAR_AFTER);
            }

            dots.forEach(function (dot, i) {
                dot.classList.toggle('is-active', i === index);
                dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
            });
        }

        // Automatic stepping. It pauses while the pointer is over the flip view
        // or the keyboard focus is inside it, so it cannot pull a slide away
        // from someone reading it, and restarts after every manual step.
        //
        // It keeps running under prefers-reduced-motion. That setting turns the
        // sliding animation off - the stylesheet sees to that - so those
        // visitors get a plain swap every few seconds rather than a carousel
        // gliding about, which is the part that setting is about.
        var INTERVAL = 8000;
        var timer = null;

        function stop() {
            if (timer !== null) { clearInterval(timer); timer = null; }
        }

        function start() {
            stop();
            if (document.hidden) { return; }
            timer = setInterval(function () { show(index + 1, true); }, INTERVAL);
        }

        function step(forwards) {
            show(forwards ? index + 1 : index - 1, forwards);
            start();
        }

        flipview.querySelector('.flipview-prev').addEventListener('click', function () { step(false); });
        flipview.querySelector('.flipview-next').addEventListener('click', function () { step(true); });

        flipview.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowLeft') { step(false); e.preventDefault(); }
            if (e.key === 'ArrowRight') { step(true); e.preventDefault(); }
        });

        flipview.addEventListener('mouseenter', stop);
        flipview.addEventListener('mouseleave', start);
        flipview.addEventListener('focusin', stop);
        flipview.addEventListener('focusout', start);
        dotBar.addEventListener('mouseenter', stop);
        dotBar.addEventListener('mouseleave', start);
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) { stop(); } else { start(); }
        });

        index = null;
        show(0, true);
        start();
    }());
</script>
